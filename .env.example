# Local stack (docker compose).
DATABASE_URL=postgresql://infringement:infringement@localhost:5432/infringement
S3_BUCKET=infringement
SQS_TASKS_QUEUE=activity-tasks
SQS_RESULTS_QUEUE=activity-results
AWS_REGION=eu-central-1

# Local development only: boto3 reads these and sends S3/SQS calls to SeaweedFS and ElasticMQ.
# Never set them on EC2 or Lambda.
AWS_ENDPOINT_URL_S3=http://localhost:9000
AWS_ENDPOINT_URL_SQS=http://localhost:9324
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
